# SkySim AI Environment Configuration
# Copy to .env for local overrides (Zero plaintext production secrets in client bundles)

# GCP / Cloud Storage Direct Upload Pipeline
GCS_UPLOAD_BUCKET=skysim-ai-raw-uploads
SKYSIM_USE_MOCK_GCS=false

# GCP Hard Budget Cap & Circuit Breaker (Section 7, Guardrail #2)
GCP_MONTHLY_BUDGET_USD=100.0
GCP_ALERT_50_USD=50.0
GCP_ALERT_90_USD=90.0
GCP_HARD_CUTOFF_USD=95.0
GCP_CURRENT_SPEND_USD=12.50
API_QUOTA_USAGE_PCT=12.5
SKYSIM_FAIL_CLOSED_QUOTA=false
CLOUD_RUN_MAX_INSTANCES=3

# World Model & Multimodal Framing Audit Connectors (Default: local deterministic mock)
SKYSIM_USE_LIVE_GENIE=false
SKYSIM_USE_LIVE_GEMINI=false

# Frontend -> Backend URL
NEXT_PUBLIC_API_URL=http://localhost:8000
